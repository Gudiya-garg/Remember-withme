# Personal Memory Companion Configuration
# Copy this file to .env or backend/.env

# Backend Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Optional AI / LLM Service Integration (Architecture is pre-wired for OpenAI / Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL (leave blank for local Vite dev proxy to /api)
# VITE_API_URL=http://localhost:5000/api
